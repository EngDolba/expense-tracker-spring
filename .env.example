# libpq form (Neon/RDS/Railway) or a jdbc: URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ledger
APP_USERNAME=admin
# bcrypt hash; the old app's `$2b$` hashes work unchanged.
# APP_PASSWORD_HASH_BASE64 is accepted instead, for env files that mangle `$`.
APP_PASSWORD_HASH=$2b$12$replace_me
SESSION_SECRET=replace-with-at-least-32-random-characters
# false only for plain-http local development.
APP_SECURE_COOKIE=true
